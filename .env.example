# Thunder Bay Auto — configuration du site.
# Copier en `client/.env` (ou définir ces variables dans l'hébergeur).
# Tout ce qui commence par VITE_ part dans le navigateur : n'y mettez jamais
# la clé `service_role` de Supabase.

# Adresse du projet Supabase, par exemple https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Clé publique « anon ». Elle est destinée au navigateur : les politiques RLS
# de la migration décident de ce qu'elle peut lire et écrire.
VITE_SUPABASE_ANON_KEY=

# Compte administrateur. L'écran de déverrouillage ne demande qu'un mot de passe :
# cette adresse est celle utilisée pour la connexion Supabase derrière.
VITE_ADMIN_EMAIL=
