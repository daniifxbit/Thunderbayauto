# Espace administrateur — configuration du serveur.
# Copier en `.env` et charger avant `npm start` (ou définir ces variables
# directement dans l'environnement de déploiement).

# Mot de passe de l'espace administrateur. OBLIGATOIRE en production :
# sans lui, celui retenu pendant la conception reste actif.
ADMIN_PASSWORD=

# Variante : empreinte déjà calculée, au format scrypt$<sel hex>$<clé hex>.
# ADMIN_PASSWORD_HASH=

PORT=8787

# Emplacement de la base SQLite et des images envoyées.
# TBA_DATA_DIR=/var/lib/thunder-bay-auto

# Nombre de proxys de confiance devant le serveur (pour l'adresse IP réelle).
# TRUST_PROXY=1

# `production` pose le cookie de session en `secure` : exige HTTPS.
NODE_ENV=production

# Adresse du site public, cible des liens « Voir le site » (build du client).
# VITE_PUBLIC_SITE_URL=https://thunderbayauto.example
